NODE_ENV=development
APP_PORT=5000
APP_URL=http://localhost:5000
API_URL=http://localhost:5000/api/v1
CLIENT_URL=http://localhost:3000
MONGODB_URL=mongodb://admin:admin@localhost:27017/eaz_community?authSource=admin
REDIS_URL=redis://localhost:6379
TYPESENSE_ENABLED=false
TYPESENSE_URL=http://localhost:8108
TYPESENSE_API_KEY=dev-typesense-key
JWT_SECRET=change-me-in-production-at-least-32-characters
JWT_REFRESH_SECRET=change-me-in-production-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Express `trust proxy`: 'false' (default) | 'true' | hop count e.g. '1' | preset e.g. 'loopback'.
# Only enable behind a trusted proxy (Nginx) — otherwise clients can spoof their IP past rate limits.
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20
OTP_RATE_LIMIT_WINDOW_MS=3600000
OTP_RATE_LIMIT_MAX=3
CHANNEL_POST_RATE_LIMIT_WINDOW_MS=900000
CHANNEL_POST_RATE_LIMIT_MAX=30
STORY_RATE_LIMIT_WINDOW_MS=900000
STORY_RATE_LIMIT_MAX=20
STORY_TTL_HOURS=24
STORY_MEDIA_MAX_SIZE_MB=25
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_SENDER_ID=
SMS_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AVATAR_MAX_SIZE_MB=5
E2EE_ENABLED=true
E2EE_PRE_KEY_BATCH_SIZE=100
E2EE_ONE_TIME_PRE_KEY_BATCH_SIZE=100