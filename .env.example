# =====================================
# Application
# =====================================
NODE_ENV=development
APP_NAME=Eaz Community
APP_PORT=5000
APP_URL=http://localhost:5000
API_URL=http://localhost:5000/api/v1
CLIENT_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# =====================================
# MongoDB
# =====================================
MONGODB_URL=mongodb://localhost:27017/eaz_community
MONGODB_USER=
MONGODB_PASSWORD=

# =====================================
# Redis
# =====================================
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# =====================================
# JWT
# =====================================
JWT_SECRET=replace_with_a_long_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_COOKIE_NAME=jwt_refresh

# =====================================
# Cloudinary (media uploads)
# =====================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=

# =====================================
# Paystack (payments)
# =====================================
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# =====================================
# Email (SMTP)
# =====================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com
EMAIL_SERVICE=
EMAIL_API_KEY=

# =====================================
# Firebase Cloud Messaging (push notifications)
# =====================================
FCM_SERVER_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =====================================
# AI / Translation
# =====================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
AI_TRANSLATION_API_KEY=

# =====================================
# OTP / Twilio (optional SMS)
# =====================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SERVICE_SID=
OTP_EXPIRES_IN=5m

# =====================================
# Rate Limiting
# =====================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =====================================
# BullMQ (background queues)
# =====================================
QUEUE_CONCURRENCY=10
