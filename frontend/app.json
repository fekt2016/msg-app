{
  "expo": {
    "name": "Eaz Community",
    "slug": "eaz-community",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fekt2016.eaz-community"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.fekt2016.eazcommunity"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Eaz Community to access your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Eaz Community to access your contacts so you can find friends to chat with."
        }
      ],
      "expo-video"
    ]
  }
}
