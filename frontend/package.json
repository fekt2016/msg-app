{
  "name": "@eaz-community/frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Eaz Community mobile app (React Native + Expo + TypeScript).",
  "main": "index.ts",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "test": "jest --coverage --forceExit",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^2.2.0",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@nozbe/watermelondb": "^0.28.0",
    "@react-navigation/bottom-tabs": "^7.18.14",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "@scure/bip39": "^2.2.0",
    "@tanstack/react-query": "^5.101.4",
    "axios": "^1.19.0",
    "expo": "~57.0.23",
    "expo-application": "~57.0.3",
    "expo-clipboard": "~57.0.2",
    "expo-contacts": "~57.0.5",
    "expo-crypto": "^57.0.3",
    "expo-device": "~57.0.2",
    "expo-image-picker": "~57.0.18",
    "expo-notifications": "~57.0.19",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@config-plugins/detox": "^11.0.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@types/react-native": "^0.73.0",
    "detox": "^20.51.4",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "ts-jest": "^29.4.12",
    "typescript": "~6.0.3"
  }
}
