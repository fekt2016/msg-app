# API base URL for the backend. Physical devices (Expo Go on a real phone)
# need the host machine's LAN IP; the Android emulator works with the default
# 10.0.2.2 and does not need this set. Copy to .env and fill in.
EXPO_PUBLIC_API_URL=http://<your-mac-lan-ip>:5000/api/v1

# EAS project id used to mint an Expo push token (getExpoPushTokenAsync).
# Get it from `eas init` or the Expo dashboard → Project settings. Only needed
# for push notifications; without it push registration is skipped.
EXPO_PUBLIC_EAS_PROJECT_ID=